// Runners League — core data model
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & Social ----------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String
  avatarUrl   String?
  bio         String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gears            Gear[]
  activities       Activity[]
  gearReviews      GearReview[]
  raceEntries      RaceEntry[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  externalAccounts ExternalAccount[]

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")

  @@index([username])
}

model Follow {
  id         String   @id @default(cuid())
  follower   User     @relation("Follower", fields: [followerId], references: [id])
  followerId String
  followee   User     @relation("Followee", fields: [followeeId], references: [id])
  followeeId String
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// Strava / Garmin OAuth linkage for auto-syncing activities
model ExternalAccount {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  provider     ExternalProvider
  providerUid  String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([provider, providerUid])
  @@index([userId])
}

enum ExternalProvider {
  STRAVA
  GARMIN
}

// ---------- Gear Locker ----------

model Gear {
  id            String     @id @default(cuid())
  owner         User       @relation(fields: [ownerId], references: [id])
  ownerId       String
  category      GearCategory
  brand         String
  model         String
  nickname      String?
  purchaseDate  DateTime?
  retiredAt     DateTime?
  totalDistanceM Int       @default(0) // denormalized, updated as activities link in
  notes         String?
  createdAt     DateTime   @default(now())

  activityLinks ActivityGear[]
  reviews       GearReview[]

  @@index([ownerId])
  @@index([category])
}

enum GearCategory {
  SHOE
  WATCH
  APPAREL
  ACCESSORY
  NUTRITION
}

model GearReview {
  id        String   @id @default(cuid())
  gear      Gear     @relation(fields: [gearId], references: [id])
  gearId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  rating    Int // 1-5
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([gearId])
}

// ---------- Activities ----------

model Activity {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  source        ActivitySource @default(MANUAL)
  externalId    String?      // id from Strava/Garmin, for dedupe
  title         String?
  distanceM     Int
  durationSec   Int
  avgPaceSecPerKm Int?
  elevationGainM Int?
  startedAt     DateTime
  routeGeoJson  Json?
  createdAt     DateTime     @default(now())

  gearLinks ActivityGear[]
  comments  Comment[]
  likes     Like[]

  @@unique([source, externalId])
  @@index([userId, startedAt])
}

enum ActivitySource {
  MANUAL
  STRAVA
  GARMIN
}

// join table: which gear was used on which activity
model ActivityGear {
  activity   Activity @relation(fields: [activityId], references: [id])
  activityId String
  gear       Gear     @relation(fields: [gearId], references: [id])
  gearId     String

  @@id([activityId, gearId])
}

// ---------- Races ----------

model Race {
  id          String    @id @default(cuid())
  name        String
  distanceM   Int
  eventDate   DateTime
  location    String
  websiteUrl  String?
  description String?
  createdAt   DateTime  @default(now())

  entries RaceEntry[]

  @@index([eventDate])
}

model RaceEntry {
  id         String    @id @default(cuid())
  race       Race      @relation(fields: [raceId], references: [id])
  raceId     String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  finishTimeSec Int?
  reviewBody String?
  createdAt  DateTime  @default(now())

  @@unique([raceId, userId])
  @@index([userId])
}

// ---------- Content: training posts / articles / forum ----------

model Post {
  id        String     @id @default(cuid())
  author    User       @relation(fields: [authorId], references: [id])
  authorId  String
  type      PostType
  title     String
  body      String
  tags      String[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  comments Comment[]
  likes    Like[]

  @@index([type])
  @@index([authorId])
}

enum PostType {
  TRAINING_PLAN
  ARTICLE
  QUESTION
}

// ---------- Shared engagement primitives ----------

model Comment {
  id         String    @id @default(cuid())
  author     User      @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  createdAt  DateTime  @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
  post       Post?     @relation(fields: [postId], references: [id])
  postId     String?

  @@index([activityId])
  @@index([postId])
}

model Like {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
  post       Post?     @relation(fields: [postId], references: [id])
  postId     String?

  @@unique([userId, activityId])
  @@unique([userId, postId])
}
