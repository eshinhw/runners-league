// Runners League — core data model
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & Social ----------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayId   String   @unique // public handle shown on Rankings/Community instead of the real name
  firstName   String
  lastName    String?
  avatarUrl   String?
  bio         String?
  city        String?
  country     String?
  gender      Gender   @default(UNSPECIFIED)
  birthDate   DateTime?
  weightKg    Float?
  heightCm    Int?
  region      Region?
  unitSystem  UnitSystem @default(METRIC)
  language    Language   @default(EN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auth.js (NextAuth) PrismaAdapter-managed fields
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  gears            Gear[]
  activities       Activity[]
  gearReviews      GearReview[]
  raceEntries      RaceEntry[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  tracks           Track[]
  externalAccounts ExternalAccount[]
  deviceTokens     DeviceToken[]

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")

  @@index([username])
  @@index([gender])
  @@index([region])
}

// ---------- Auth.js (NextAuth) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum Language {
  KO
  EN
}

enum Region {
  ONTARIO
  QUEBEC
  BRITISH_COLUMBIA
  ALBERTA
  MANITOBA
  SASKATCHEWAN
  NOVA_SCOTIA
  NEW_BRUNSWICK
  NEWFOUNDLAND_AND_LABRADOR
  PRINCE_EDWARD_ISLAND
  YUKON
  NORTHWEST_TERRITORIES
  NUNAVUT
  OTHER
}

model Follow {
  id         String   @id @default(cuid())
  follower   User     @relation("Follower", fields: [followerId], references: [id])
  followerId String
  followee   User     @relation("Followee", fields: [followeeId], references: [id])
  followeeId String
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// Strava / Garmin OAuth linkage for auto-syncing activities
model ExternalAccount {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  provider     ExternalProvider
  providerUid  String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([provider, providerUid])
  @@index([userId])
}

enum ExternalProvider {
  STRAVA
  GARMIN
}

// ---------- Gear Locker ----------

model Gear {
  id            String     @id @default(cuid())
  owner         User       @relation(fields: [ownerId], references: [id])
  ownerId       String
  category      GearCategory
  brand         String
  model         String? // some categories (Apparel, Nutrition) are brand-only, no specific model
  nickname      String?
  photoUrl      String?
  purchaseDate  DateTime?
  retiredAt     DateTime?
  // At most one favorite per owner+category — enforced in code (setting one
  // clears any other), not a DB constraint, since "no favorite yet" is valid.
  isFavorite    Boolean    @default(false)
  totalDistanceM Int       @default(0) // denormalized, updated as activities link in
  notes         String?
  createdAt     DateTime   @default(now())

  activityLinks ActivityGear[]
  reviews       GearReview[]

  @@index([ownerId])
  @@index([category])
}

enum GearCategory {
  SHOE
  WATCH
  APPAREL
  HAT
  ACCESSORY
  NUTRITION
}

model GearReview {
  id        String   @id @default(cuid())
  gear      Gear     @relation(fields: [gearId], references: [id])
  gearId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  rating    Int // 1-5
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([gearId])
}

// ---------- Activities ----------

model Activity {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  source        ActivitySource @default(MANUAL)
  externalId    String?      // id from Strava/Garmin, for dedupe
  title         String?
  distanceM     Int
  durationSec   Int
  avgPaceSecPerKm Int?
  elevationGainM Int?
  runType       RunType?
  major         MarathonMajor? // set when this activity is a World Marathon Majors result
  startedAt     DateTime
  routeGeoJson  Json?
  location      String? // free-text race/run location, e.g. "Boston, MA" — distinct from the user's home city
  photoUrls     String[]     @default([]) // user-uploaded evidence photos (bib, medal, finish clock) for manual entries
  avgHeartRateBpm Int? // optional self-reported stat, manual entries only
  avgCadenceSpm   Int? // optional self-reported stat (steps per minute), manual entries only
  createdAt     DateTime     @default(now())

  gearLinks ActivityGear[]
  comments  Comment[]
  likes     Like[]

  @@unique([source, externalId])
  @@index([userId, startedAt])
  @@index([runType, startedAt])
  @@index([major])
}

// The World Marathon Majors — the series is still growing (Sydney joined in
// 2025, Cape Town is set to join in 2027), so this list is expected to gain
// values over time rather than staying fixed at any particular count.
enum MarathonMajor {
  TOKYO
  BOSTON
  LONDON
  BERLIN
  CHICAGO
  NEW_YORK
  SYDNEY
}

enum ActivitySource {
  MANUAL
  STRAVA
  GARMIN
  APPLE_HEALTH
}

// Personal access token for the iOS HealthKit companion app to authenticate
// its sync requests. Never store the raw token — only its hash.
model DeviceToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// SPEED/TEMPO = interval & threshold work, LSD = long slow distance, EASY = easy pace, RACE = official race effort
enum RunType {
  SPEED
  TEMPO
  LSD
  EASY
  RACE
}

// join table: which gear was used on which activity
model ActivityGear {
  activity   Activity @relation(fields: [activityId], references: [id])
  activityId String
  gear       Gear     @relation(fields: [gearId], references: [id])
  gearId     String

  @@id([activityId, gearId])
}

// ---------- Races ----------

model Race {
  id          String    @id @default(cuid())
  name        String
  distanceM   Int
  eventDate   DateTime
  location    String
  websiteUrl  String?
  description String?
  createdAt   DateTime  @default(now())

  entries RaceEntry[]

  @@index([eventDate])
}

model RaceEntry {
  id         String    @id @default(cuid())
  race       Race      @relation(fields: [raceId], references: [id])
  raceId     String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  finishTimeSec Int?
  reviewBody String?
  createdAt  DateTime  @default(now())

  @@unique([raceId, userId])
  @@index([userId])
}

// ---------- Rankings ----------
//
// Rankings are computed live, directly from Activity rows carrying a `major`
// value — there is no separate leaderboard-archive model. A world major's
// results don't change after the fact, so nothing needs periodic snapshotting.

// ---------- Content: training posts / articles / forum ----------

model Post {
  id        String     @id @default(cuid())
  author    User       @relation(fields: [authorId], references: [id])
  authorId  String
  type      PostType
  title     String
  body      String
  tags      String[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  comments Comment[]
  likes    Like[]

  @@index([type])
  @@index([authorId])
}

enum PostType {
  DISCUSSION
  TRAINING_PLAN
  ARTICLE
  QUESTION
}

// ---------- Community Playlist ----------
//
// Songs are deduplicated by iTunes track id — sharing a song that's already
// on the chart just upvotes the existing entry instead of creating a
// duplicate row. "Verification" means every track is looked up against the
// iTunes Search API server-side before it's inserted, so only real songs
// ever make it onto the chart.

model Track {
  id            String   @id @default(cuid())
  itunesTrackId String   @unique
  title         String
  artist        String
  albumArtUrl   String?
  previewUrl    String?
  itunesUrl     String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedById String
  createdAt     DateTime @default(now())

  likes Like[]

  @@index([submittedById])
}

// ---------- Shared engagement primitives ----------

model Comment {
  id         String    @id @default(cuid())
  author     User      @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  createdAt  DateTime  @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
  post       Post?     @relation(fields: [postId], references: [id])
  postId     String?

  @@index([activityId])
  @@index([postId])
}

model Like {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
  post       Post?     @relation(fields: [postId], references: [id])
  postId     String?
  track      Track?    @relation(fields: [trackId], references: [id])
  trackId    String?

  @@unique([userId, activityId])
  @@unique([userId, postId])
  @@unique([userId, trackId])
}
