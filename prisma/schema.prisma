// Runners League — core data model
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & Social ----------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String
  avatarUrl   String?
  bio         String?
  location    String?
  gender      Gender   @default(UNSPECIFIED)
  birthYear   Int?
  region      Region?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auth.js (NextAuth) PrismaAdapter-managed fields
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  gears            Gear[]
  activities       Activity[]
  gearReviews      GearReview[]
  raceEntries      RaceEntry[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  externalAccounts ExternalAccount[]
  leaderboardWins  LeaderboardWinner[]
  deviceTokens     DeviceToken[]
  challengeEntries ChallengeParticipant[]

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followee")

  @@index([username])
  @@index([gender])
  @@index([region])
}

// ---------- Auth.js (NextAuth) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum Region {
  SEOUL
  BUSAN
  INCHEON
  DAEGU
  DAEJEON
  GWANGJU
  ULSAN
  SEJONG
  GYEONGGI
  GANGWON
  CHUNGBUK
  CHUNGNAM
  JEONBUK
  JEONNAM
  GYEONGBUK
  GYEONGNAM
  JEJU
  OTHER
}

model Follow {
  id         String   @id @default(cuid())
  follower   User     @relation("Follower", fields: [followerId], references: [id])
  followerId String
  followee   User     @relation("Followee", fields: [followeeId], references: [id])
  followeeId String
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// Strava / Garmin OAuth linkage for auto-syncing activities
model ExternalAccount {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  provider     ExternalProvider
  providerUid  String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([provider, providerUid])
  @@index([userId])
}

enum ExternalProvider {
  STRAVA
  GARMIN
}

// ---------- Gear Locker ----------

model Gear {
  id            String     @id @default(cuid())
  owner         User       @relation(fields: [ownerId], references: [id])
  ownerId       String
  category      GearCategory
  brand         String
  model         String
  nickname      String?
  purchaseDate  DateTime?
  retiredAt     DateTime?
  totalDistanceM Int       @default(0) // denormalized, updated as activities link in
  notes         String?
  createdAt     DateTime   @default(now())

  activityLinks ActivityGear[]
  reviews       GearReview[]

  @@index([ownerId])
  @@index([category])
}

enum GearCategory {
  SHOE
  WATCH
  APPAREL
  ACCESSORY
  NUTRITION
}

model GearReview {
  id        String   @id @default(cuid())
  gear      Gear     @relation(fields: [gearId], references: [id])
  gearId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  rating    Int // 1-5
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([gearId])
}

// ---------- Activities ----------

model Activity {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  source        ActivitySource @default(MANUAL)
  externalId    String?      // id from Strava/Garmin, for dedupe
  title         String?
  distanceM     Int
  durationSec   Int
  avgPaceSecPerKm Int?
  elevationGainM Int?
  runType       RunType?
  startedAt     DateTime
  routeGeoJson  Json?
  createdAt     DateTime     @default(now())

  gearLinks ActivityGear[]
  comments  Comment[]
  likes     Like[]

  @@unique([source, externalId])
  @@index([userId, startedAt])
  @@index([runType, startedAt])
}

enum ActivitySource {
  MANUAL
  STRAVA
  GARMIN
  APPLE_HEALTH
}

// Personal access token for the iOS HealthKit companion app to authenticate
// its sync requests. Never store the raw token — only its hash.
model DeviceToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// SPEED/TEMPO = interval & threshold work, LSD = long slow distance, EASY = easy pace, RACE = official race effort
enum RunType {
  SPEED
  TEMPO
  LSD
  EASY
  RACE
}

// join table: which gear was used on which activity
model ActivityGear {
  activity   Activity @relation(fields: [activityId], references: [id])
  activityId String
  gear       Gear     @relation(fields: [gearId], references: [id])
  gearId     String

  @@id([activityId, gearId])
}

// ---------- Races ----------

model Race {
  id          String    @id @default(cuid())
  name        String
  distanceM   Int
  eventDate   DateTime
  location    String
  websiteUrl  String?
  description String?
  createdAt   DateTime  @default(now())

  entries RaceEntry[]

  @@index([eventDate])
}

model RaceEntry {
  id         String    @id @default(cuid())
  race       Race      @relation(fields: [raceId], references: [id])
  raceId     String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  finishTimeSec Int?
  reviewBody String?
  createdAt  DateTime  @default(now())

  @@unique([raceId, userId])
  @@index([userId])
}

// ---------- Rankings ----------

// Archived top finishers for a closed leaderboard period + segment, so past
// champions stay visible ("Hall of Fame") even after the live period rolls over.
model LeaderboardWinner {
  id            String     @id @default(cuid())
  periodType    PeriodType
  periodKey     String // e.g. "2026-06" for monthly, "2026-W23" for weekly
  periodLabel   String // human-readable, e.g. "2026년 6월"

  // Segment this ranking was computed within. All null = overall/unsegmented board.
  gender  Gender?
  region  Region?
  runType RunType?
  ageBand String? // e.g. "20s", "30s" — snapshotted since birthYear-derived bands drift with time

  rank           Int
  user           User   @relation(fields: [userId], references: [id])
  userId         String
  totalDistanceM Int
  runCount       Int

  createdAt DateTime @default(now())

  @@index([periodType, periodKey])
  @@index([userId])
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

// App-native virtual race for a single period (week/month), auto-generated
// from a fixed template set. Its leaderboard is never snapshotted — like the
// main Rankings board, it's recomputed live from Activity + the participant
// list, so a past challenge's standings stay accurate forever with no cron.
model Challenge {
  id          String     @id @default(cuid())
  templateKey String // stable key from the template config, e.g. "weekly-5k"
  periodType  PeriodType
  periodKey   String // e.g. "2026-W34" or "2026-08"
  title       String
  description String?
  targetDistanceM Int? // null = open mileage race, no fixed goal
  createdAt   DateTime @default(now())

  participants ChallengeParticipant[]

  @@unique([periodType, periodKey, templateKey])
  @@index([periodType, periodKey])
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([userId])
}

// ---------- Content: training posts / articles / forum ----------

model Post {
  id        String     @id @default(cuid())
  author    User       @relation(fields: [authorId], references: [id])
  authorId  String
  type      PostType
  title     String
  body      String
  tags      String[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  comments Comment[]
  likes    Like[]

  @@index([type])
  @@index([authorId])
}

enum PostType {
  TRAINING_PLAN
  ARTICLE
  QUESTION
}

// ---------- Shared engagement primitives ----------

model Comment {
  id         String    @id @default(cuid())
  author     User      @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  createdAt  DateTime  @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
  post       Post?     @relation(fields: [postId], references: [id])
  postId     String?

  @@index([activityId])
  @@index([postId])
}

model Like {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
  post       Post?     @relation(fields: [postId], references: [id])
  postId     String?

  @@unique([userId, activityId])
  @@unique([userId, postId])
}
