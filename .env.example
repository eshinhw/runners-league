# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Postgres) ---
# App runtime connection. In production with Neon, use the pooled connection
# string (the one with "-pooler" in the hostname).
DATABASE_URL="postgres://user:password@localhost:5432/runners_league?sslmode=disable"
# Migrations / Prisma CLI connection. In production with Neon, use the
# *unpooled* connection string — Prisma's migration engine needs session-level
# features (advisory locks) that PgBouncer transaction pooling doesn't support.
# Safe to leave unset locally; prisma.config.ts falls back to DATABASE_URL.
# DIRECT_URL="postgres://user:password@localhost:5432/runners_league?sslmode=disable"

# --- Auth (Auth.js) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email sign-in (magic link) ---
EMAIL_SERVER=
EMAIL_FROM=

# --- Strava OAuth (planned integration) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Cloudflare R2 (image uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Analytics (Google Analytics 4) ---
# Only loaded when NODE_ENV=production, so a local value here is harmless.
NEXT_PUBLIC_GA_ID=
